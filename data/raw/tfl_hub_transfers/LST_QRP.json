rt your journey."], "recommendedMaxAgeMinutes": 5, "searchCriteria": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.SearchCriteria, Tfl.Api.Presentation.Entities", "dateTime": "2026-11-10T09:00:00", "dateTimeType": "Arriving", "timeAdjustments": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.TimeAdjustments, Tfl.Api.Presentation.Entities", "earliest": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.TimeAdjustment, Tfl.Api.Presentation.Entities", "date": "20261110", "time": "0300", "timeIs": "arriving", "uri": "/journey/journeyresults/910glivst/to/910gpckhmqd?date=20261110&time=0300&timeIs=arriving&journeypreference=leasttime&mode=tube%2cdlr%2coverground%2celizabeth-line%2cwalking"}, "earlier": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.TimeAdjustment, Tfl.Api.Presentation.Entities", "date": "20261110", "time": "0826", "timeIs": "arriving", "uri": "/journey/journeyresults/910glivst/to/910gpckhmqd?date=20261110&time=0826&timeIs=arriving&journeypreference=leasttime&mode=tube%2cdlr%2coverground%2celizabeth-line%2cwalking"}, "later": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.TimeAdjustment, Tfl.Api.Presentation.Entities", "date": "20261110", "time": "0915", "timeIs": "arriving", "uri": "/journey/journeyresults/910glivst/to/910gpckhmqd?date=20261110&time=0915&timeIs=arriving&journeypreference=leasttime&mode=tube%2cdlr%2coverground%2celizabeth-line%2cwalking"}, "latest": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.TimeAdjustment, Tfl.Api.Presentation.Entities", "date": "20261111", "time": "0300", "timeIs": "arriving", "uri": "/journey/journeyresults/910glivst/to/910gpckhmqd?date=20261111&time=0300&timeIs=arriving&journeypreference=leasttime&mode=tube%2cdlr%2coverground%2celizabeth-line%2cwalking"}}}, "journeyVector": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.JourneyVector, Tfl.Api.Presentation.Entities", "from": "1000138", "to": "1001233", "via": "", "uri": "/journey/journeyresults/910glivst/to/