ute step-free walk via the street to Euston. Euston Square is step-free westbound only, so you cannot do the same journey in reverse to return to Liverpool Street. \n\nMini ramps are available at Liverpool Street, Kings Cross and Euston Square. To request a mini ramp speak to a member of staff before you start your journey."], "recommendedMaxAgeMinutes": 5, "searchCriteria": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.SearchCriteria, Tfl.Api.Presentation.Entities", "dateTime": "2026-11-10T09:00:00", "dateTimeType": "Arriving", "timeAdjustments": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.TimeAdjustments, Tfl.Api.Presentation.Entities", "earliest": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.TimeAdjustment, Tfl.Api.Presentation.Entities", "date": "20261110", "time": "0300", "timeIs": "arriving", "uri": "/journey/journeyresults/910gfrndxr/to/910glivstll?date=20261110&time=0300&timeIs=arriving&journeypreference=leasttime&mode=tube%2cdlr%2coverground%2celizabeth-line%2cwalking"}, "earlier": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.TimeAdjustment, Tfl.Api.Presentation.Entities", "date": "20261110", "time": "0853", "timeIs": "arriving", "uri": "/journey/journeyresults/910gfrndxr/to/910glivstll?date=20261110&time=0853&timeIs=arriving&journeypreference=leasttime&mode=tube%2cdlr%2coverground%2celizabeth-line%2cwalking"}, "later": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.TimeAdjustment, Tfl.Api.Presentation.Entities", "date": "20261110", "time": "0915", "timeIs": "arriving", "uri": "/journey/journeyresults/910gfrndxr/to/910glivstll?date=20261110&time=0915&timeIs=arriving&journeypreference=leasttime&mode=tube%2cdlr%2coverground%2celizabeth-line%2cwalking"}, "latest": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.TimeAdjustment, Tfl.Api.Presentation.Entities", "date": "20261111", "time": "0300", "timeIs": "arriving", "uri": "/journey/journeyresults/910gfrndxr/to/910glivstll?date=20261111&time=0300&time