fare.</p>", "type": "allRailModes"}, {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.FareCaveat, Tfl.Api.Presentation.Entities", "text": "The price shown is a single adult pay as you go fare.", "type": "generic"}]}}], "lines": [{"$type": "Tfl.Api.Presentation.Entities.Line, Tfl.Api.Presentation.Entities", "id": "weaver", "name": "Weaver", "modeName": "overground", "disruptions": [], "created": "2026-09-22T09:53:41.037Z", "modified": "2026-09-22T09:53:41.037Z", "lineStatuses": [{"$type": "Tfl.Api.Presentation.Entities.LineStatus, Tfl.Api.Presentation.Entities", "id": 0, "statusSeverity": 10, "statusSeverityDescription": "Good Service", "created": "0001-01-01T00:00:00", "validityPeriods": []}], "routeSections": [], "serviceTypes": [{"$type": "Tfl.Api.Presentation.Entities.LineServiceTypeInfo, Tfl.Api.Presentation.Entities", "name": "Regular", "uri": "/Line/Route?ids=Weaver&serviceTypes=Regular"}], "crowding": {"$type": "Tfl.Api.Presentation.Entities.Crowding, Tfl.Api.Presentation.Entities"}}], "stopMessages": ["Step-free routes from Liverpool Street to Kings Cross St Pancras and Euston (via Euston Square): For Kings Cross, take a Metropolitan line eastbound train (platform 1) to Aldgate. Stay on the train. After a few minutes, the train reverses and travels westbound: you can get off at Kings Cross step-free. Eastbound journeys from Kings Cross are step-free direct to Liverpool Street. \n\nFor Euston, take a Metropolitan line eastbound train (platform 1) to Aldgate. Stay on the train. After a few minutes, the train reverses and travels westbound and you can get off at Euston Square step-free. It is then a 10 minute step-free walk via the street to Euston. Euston Square is step-free westbound only, so you cannot do the same journey in reverse to return to Liverpool Street. \n\nMini ramps are available at Liverpool Street, Kings Cross and Euston Square. To request a mini ramp speak to a member of staff before you start your journey."], "recommendedMaxAgeMinutes"