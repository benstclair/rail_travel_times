, "status": "Unknown", "motType": "1", "network": "tfl"}, "disruptions": [{"$type": "Tfl.Api.Presentation.Entities.Disruption, Tfl.Api.Presentation.Entities", "category": "Information", "type": "stopInfo", "categoryDescription": "Information", "description": "Step-free routes from Liverpool Street to Kings Cross St Pancras and Euston (via Euston Square): For Kings Cross, take a Metropolitan line eastbound train (platform 1) to Aldgate. Stay on the train. After a few minutes, the train reverses and travels westbound: you can get off at Kings Cross step-free. Eastbound journeys from Kings Cross are step-free direct to Liverpool Street. \n\nFor Euston, take a Metropolitan line eastbound train (platform 1) to Aldgate. Stay on the train. After a few minutes, the train reverses and travels westbound and you can get off at Euston Square step-free. It is then a 10 minute step-free walk via the street to Euston. Euston Square is step-free westbound only, so you cannot do the same journey in reverse to return to Liverpool Street. \n\nMini ramps are available at Liverpool Street, Kings Cross and Euston Square. To request a mini ramp speak to a member of staff before you start your journey.", "summary": "", "additionalInfo": "", "created": "2025-12-12T05:41:00", "lastUpdate": "2025-12-12T05:47:00"}], "plannedWorks": [], "distance": 99.0, "isDisrupted": true, "hasFixedLocations": true, "scheduledDepartureTime": "2026-11-10T08:42:00", "scheduledArrivalTime": "2026-11-10T08:57:00"}], "fare": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.JourneyFare, Tfl.Api.Presentation.Entities", "totalCost": 310, "fares": [{"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.Fare, Tfl.Api.Presentation.Entities", "lowZone": 1, "highZone": 1, "cost": 310, "chargeProfileName": "Normal", "isHopperFare": false, "chargeLevel": "Peak", "peak": 310, "offPeak": 300, "taps": [{"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.FareTap, Tfl.Api.Presentation.Entities", "atcoCode": "940GZZLU