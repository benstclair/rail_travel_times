ategory": "PlannedWork", "type": "stopInfo", "categoryDescription": "PlannedWork", "description": "BANK AND MONUMENT STATIONS: From Monday 20 October 2025 until early 2027. Replacement of escalators 4 and 5. These connect the Northern line platforms with the District and Circle line platforms. While this work takes place, the walking route between these platforms will be closed. Please allow a little longer for your journey and follow the signs, which will direct you via an alternative walking route. Depending on your journey, this route may be via street level. To pay the correct fare, just touch out as you exit and touch back in again, as you re-enter.", "summary": "", "additionalInfo": "", "created": "2025-10-07T15:02:00", "lastUpdate": "2026-10-16T14:58:00"}], "plannedWorks": [], "distance": 25.0, "isDisrupted": true, "hasFixedLocations": true, "scheduledDepartureTime": "2026-11-10T08:49:00", "scheduledArrivalTime": "2026-11-10T08:51:00"}], "fare": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.JourneyFare, Tfl.Api.Presentation.Entities", "totalCost": 360, "fares": [{"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.Fare, Tfl.Api.Presentation.Entities", "lowZone": 1, "highZone": 2, "cost": 360, "chargeProfileName": "Inbound CF", "isHopperFare": false, "chargeLevel": "Peak", "peak": 360, "offPeak": 310, "taps": [{"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.FareTap, Tfl.Api.Presentation.Entities", "atcoCode": "940GZZDLLIM", "tapDetails": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.FareTapDetails, Tfl.Api.Presentation.Entities", "modeType": "Rail", "validationType": "None", "hostDeviceType": "PVal", "nationalLocationCode": 862, "tapTimestamp": "2026-11-10T08:40:00+00:00"}}, {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.FareTap, Tfl.Api.Presentation.Entities", "atcoCode": "940GZZLULNB", "tapDetails": {"$type": "Tfl.Api.Presentation.Entities.JourneyPlanner.FareTapDetails, Tfl.Api.Presentation.Entities", "modeType": "Rail